#!/bin/sh
# Pre-commit hook of this specification repository.
#
# Checks that uml/class-diagram.puml carries the identity declared by index.adoc
# (API name, version, edition date, document reference, copyright, license, URL).
# The diagram is published on its own, so a stale title or footer would circulate
# out of the specification.
#
# Installation, once per clone:
#   git config core.hooksPath .githooks
#
# To synchronise automatically instead of blocking the commit, replace the check
# below with:
#   "$PY" tools/sync_diagram_identity.py && git add uml/class-diagram.puml

[ -f tools/sync_diagram_identity.py ] || exit 0

if command -v python >/dev/null 2>&1; then PY=python
elif command -v python3 >/dev/null 2>&1; then PY=python3
elif command -v py >/dev/null 2>&1; then PY=py
else echo "pre-commit: Python not found, check skipped." >&2; exit 0; fi

"$PY" tools/sync_diagram_identity.py --check || {
    echo "" >&2
    echo "pre-commit: class diagram identity out of sync with index.adoc." >&2
    exit 1
}
