@startuml
title
    <img:assets/logos/calypso.svg{scale=0.2}>

    Terminal Card API 3.0.+ (2026-04-21)
end title

' == THEME (class) ==

'Couleurs issues de : https://htmlcolorcodes.com/fr/tableau-de-couleur/tableau-de-couleur-design-plat/
!define C_GREY1 F8F9F9
!define C_GREY2 F2F3F4
!define C_GREY3 E5E7E9
!define C_GREY4 D7DBDD
!define C_GREY5 CACFD2
!define C_GREY6 BDC3C7
!define C_LINK 3498DB
!define C_USE 27AE60
!define C_THROW 2C3E50

' -- Styles that don't work with new version of plantuml --
skinparam stereotypeABorderColor #A9DCDF
skinparam stereotypeIBorderColor #B4A7E5
skinparam stereotypeCBorderColor #ADD1B2
skinparam stereotypeEBorderColor #EB937F
' -- END --

skinparam ClassBorderThickness 2
skinparam ArrowThickness 2

' Yellow
skinparam ClassBackgroundColor #FEFECE
skinparam ClassBorderColor #D4AC0D
' Red
skinparam ClassBackgroundColor<<red>> #FDEDEC
skinparam ClassBorderColor<<red>> #E74C3C
hide <<red>> stereotype
' Purple
skinparam ClassBackgroundColor<<purple>> #F4ECF7
skinparam ClassBorderColor<<purple>> #8E44AD
hide <<purple>> stereotype
' blue
skinparam ClassBackgroundColor<<blue>> #EBF5FB
skinparam ClassBorderColor<<blue>> #3498DB
hide <<blue>> stereotype
' Green
skinparam ClassBackgroundColor<<green>> #E9F7EF
skinparam ClassBorderColor<<green>> #27AE60
hide <<green>> stereotype
' Grey
skinparam ClassBackgroundColor<<grey>> #EAECEE
skinparam ClassBorderColor<<grey>> #2C3E50
hide <<grey>> stereotype

' == CONTENT ==

legend top
    * __Text__
    *** <color:blue><b>New element added since the last version
    *** <color:red><s><b>Element marked as deprecated since the last version
    *** <s><b>Element marked as deprecated
    *** <color:grey><b>Work in progress...
    * __Object__
    *** <back:#EBF5FB><color:#3498DB><b>Factory or interface provided by the factory
    *** <back:#FEFECE><color:#D4AC0D><b>Interface that cannot be instantiated directly by the factory
    *** <back:#FDEDEC><color:#E74C3C><b>SPI (Service Provider Interface) to be provided by the end-user
    *** <back:#E9F7EF><color:#27AE60><b>Class, enum or error
end legend

package "card" as card {

' SPI
package "spi" as spi {
    interface "CardSelectionExtensionSpi" as CardSelectionExtensionSpi <<red>> {
        +getCardSelectionRequest() → <color:blue>CardSelectionRequest
        +parse(cardSelectionResponse: <color:blue>CardSelectionResponse</color>) → SmartCardSpi
        {method} <size:10><color:#7F8C8D>    ⚠ errors: Parse</color></size>
    }
    interface SmartCardSpi <<red>> {
        +<color:blue>deactivate() → Unit
    }
    interface "<color:blue>MultichannelSmartCardSpi" as MultichannelSmartCardSpi <<red>> extends SmartCardSpi {
        +<color:blue>getChannel() → Int
    }
    ' REQUEST
    class "<color:blue>CardSelectionRequest" as CardSelectionRequest <<data>> <<green>> {
        +{field} val successfulSelectionStatusWords: Set<Int> = setOf(0x9000)
        +val cardRequest: CardRequest? = null
    }
    class "<color:blue>CardRequest" as CardRequest <<data>> <<green>> {
        +val apduRequests: List<ApduRequest>
        +val stopOnUnsuccessfulStatusWord: Boolean
    }
    class "<color:blue>ApduRequest" as ApduRequest <<data>> <<green>> {
        +val apdu: ByteArray
        +{field} val successfulStatusWords: Set<Int> = setOf(0x9000)
        +val info: String? = null
        +<color:blue>val apduExchangeMaxDuration: Long? = null
    }
}
class "CardApiProperties" as ApiProperties <<constants>> <<green>> {
    +const VERSION: String = "3.0"
}
exception "Parse" as Parse <<error>> <<green>> {
    +val message: String
    +val cause: Any?
}
interface ProxyReaderApi {
    --
    +<color:blue>transmitCardRequest(
        \t<color:blue>cardRequest: CardRequest,
        \t<color:blue>smartCard: SmartCardSpi) → CardResponse
    {method} <size:10><color:#7F8C8D>    ⚠ errors: ReaderBrokenCommunication, CardBrokenCommunication, UnexpectedStatusWord, ApduExchangeDurationExceeded</color></size>

    +<color:blue>transmitCardRequestAndCloseChannel(
        \t<color:blue>cardRequest: CardRequest,
        \t<color:blue>multichannelSmartCard: MultichannelSmartCardSpi) → CardResponse
    {method} <size:10><color:#7F8C8D>    ⚠ errors: ReaderBrokenCommunication, CardBrokenCommunication, UnexpectedStatusWord, ApduExchangeDurationExceeded</color></size>

    +<color:blue>closeChannel(multichannelSmartCard: MultichannelSmartCardSpi) → Unit
    {method} <size:10><color:#7F8C8D>    ⚠ errors: ReaderBrokenCommunication, CardBrokenCommunication</color></size>
}
' RESPONSE
class "<color:blue>CardSelectionResponse" as CardSelectionResponse <<data>> <<green>> {
    +<color:blue>val channel: Int
    +val powerOnData: String?
    +val selectApplicationResponse: ApduResponse?
    +val hasMatched: Boolean
    +val cardResponse: CardResponse?
}
class "<color:blue>CardResponse" as CardResponse <<data>> <<green>> {
    +val apduResponses: List<ApduResponse>
}
class "<color:blue>ApduResponse" as ApduResponse <<data>> <<green>> {
    +val apdu: ByteArray
    +<color:blue>val apduExchangeDuration: Long?
}

exception "ReaderBrokenCommunication\nCardBrokenCommunication\nUnexpectedStatusWord\n<color:blue>ApduExchangeDurationExceeded" as errors <<error>> <<green>> {
    +val message: String
    +val cause: Any?
    +val cardResponse: CardResponse?
    +val isCardResponseComplete: Boolean
}

}

' Associations

CardSelectionExtensionSpi ..> SmartCardSpi #C_LINK : provide >
CardSelectionExtensionSpi ..> CardSelectionRequest #C_LINK : provide >
CardSelectionExtensionSpi ..> CardSelectionResponse #C_USE : use >

CardSelectionRequest ..> CardRequest #C_USE : use >

CardRequest ..> ApduRequest #C_USE : use >

CardSelectionResponse ..> ApduResponse #C_USE : use >
CardSelectionResponse ..> CardResponse #C_USE : use >

CardResponse ..> ApduResponse #C_USE : use >

errors *-up- "0..1" CardResponse #C_LINK

ProxyReaderApi .left.> CardRequest #C_USE : use >
ProxyReaderApi .up.> SmartCardSpi #C_USE : use >
ProxyReaderApi ..> MultichannelSmartCardSpi #C_USE : use >

ProxyReaderApi .right.> CardResponse #C_LINK : provide >

' == LAYOUT ==

ApiProperties -[hidden]- Parse

' == STYLE ==

package card #C_GREY1 {}
package card.spi #C_GREY2 {}

@enduml